# Server-only secrets: never expose them in Vite defines, bundled JS, or /api/config.
GEMINI_API_KEY=
# Optional server-side key alias:
API_KEY=
# Required to enable the Gemini proxy. Generate at least 32 random characters.
# This bearer credential is for trusted server-to-server callers, NOT public browser JS.
GEMINI_PROXY_ACCESS_TOKEN=
